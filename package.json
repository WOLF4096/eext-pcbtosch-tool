{
	"name": "eext-pcbtosch-tool",
	"version": "1.2.0",
	"description": "嘉立创EDA 专业版扩展：从 PCB 反推原理图（狼黑工具 · PCB 转原理图）",
	"author": "WOLF4096",
	"license": "Apache-2.0",
	"homepage": "https://github.com/WOLF4096/eext-pcbtosch-tool",
	"engines": {
		"node": ">=20.17.0"
	},
	"scripts": {
		"build:iframe": "node scripts/build-iframe.mjs",
		"watch:iframe": "node scripts/build-iframe.mjs --watch",
		"compile": "rimraf ./dist/ && ts-node ./config/esbuild.prod.ts",
		"lint": "eslint",
		"fix": "eslint --fix",
		"build": "npm run build:iframe && npm run compile && ts-node ./build/packaged.ts"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^5.4.1",
		"@jlceda/pro-api-types": "^0.2.21",
		"@types/fs-extra": "^11.0.4",
		"esbuild": "^0.24.2",
		"eslint": "^9.37.0",
		"fs-extra": "^11.3.0",
		"ignore": "^7.0.3",
		"jszip": "^3.10.1",
		"lint-staged": "^16.2.3",
		"rimraf": "^6.0.1",
		"simple-git-hooks": "^2.13.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.3"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	},
	"lint-staged": {
		"*": "eslint --fix"
	}
}
